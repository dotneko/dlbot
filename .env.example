# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token (Developer Portal -> your app -> Bot -> Reset Token). Required.
DISCORD_TOKEN=your-bot-token-here

# Restrict /download to a single channel (leave empty to allow it everywhere).
DISCORD_CHANNEL_ID=

# Guild (server) ID for instant slash-command sync while developing.
# Leave empty to sync globally (can take up to an hour to appear).
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DLBOT_DATABASE=data/dlbot.db
DLBOT_DOWNLOAD_DIR=downloads
DLBOT_LOG_DIR=logs

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# How often (seconds) the worker polls the queue for pending jobs.
DLBOT_WORKER_POLL_INTERVAL=3
# Total attempts before a job is marked permanently failed.
DLBOT_MAX_ATTEMPTS=2
# Optional: path to a Netscape-format cookies.txt file (needed for private,
# age-restricted, or cookie-walled videos, e.g. many Instagram Reels).
DLBOT_COOKIES_FILE=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Console verbosity: DEBUG | INFO | WARNING | ERROR (file logs are always DEBUG)
DLBOT_LOG_LEVEL=INFO
